# macOS
.DS_Store

# Dependencies, virtual environments, caches (recreated by npm install / venv)
node_modules/
.venv/
__pycache__/
*.pyc

# The demo app is a separate repository (ghcp_cli_workflow_shopflow_orders): clone it into this folder as 'shopflow-orders'
/shopflow-orders/

# Track only the finished deliverables: English at the repo root (GHCP_CLI_Workflow_Demo_EN.pptx, video/),
# Korean under ko/ (ko/GHCP_CLI_Workflow_Demo_KO.pptx, ko/video/). Build/render intermediates and archives stay ignored.
*.pptx
!/GHCP_CLI_Workflow_Demo_EN.pptx
!/ko/GHCP_CLI_Workflow_Demo_KO.pptx
*.zip
/production-source/video/*/*
!/production-source/video/*/card-title.png
!/production-source/video/*/card-end.png

# Recorder/launcher logs and failed-attempt snapshots
/production-source/runs/*/*.rec.log
/production-source/runs/*/launch.out
/production-source/runs/*/*/*.snapshots/timeout-*

# Intermediates that make_assets.py writes into runs/<lang>/final
/production-source/runs/*/final/stills-spec.json
/production-source/runs/*/final/final_with_images.cast

# Recording Copilot profile: holds login state and session history, never commit it
/production-source/copilot-home/
