[1713.642798, "o", "scripts/deploy.sh production\",    \u001b[65C\u001b[90m│\u001b[m \u001b[90m│\r\r\n│\u001b[m \u001b[90m│\u001b[m   \"description\": \"Request human approval and deploy verified v1.1.0 to production\",\u001b[30C\u001b[90m│\u001b[m \u001b[90m│\r\r\n│\u001b[m \u001b[90m│\u001b[m   \"initial_wait\": 120                              \u001b[62C\u001b[90m│\u001b[m \u001b[90m│\r\r\n│\u001b[m \u001b[90m│\u001b[m }                                                            \u001b[52C\u001b[90m│\u001b[m \u001b[90m│\r\r\n│\u001b[m \u001b[90m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[m \u001b[90m│\r\r\n│\u001b[m                                                                                              \u001b[24C\u001b[90m│\r\r\n│\u001b[m Do you want to allow this tool call?                                                    \u001b[29C\u001b[90m│\r\r\n│\u001b[118C│\r\r\n│\u001b[m \u001b[97;44m❯\u001b[39m \u001b[97m1. Yes\u001b[39m                                                                                                            \u001b[m \u001b[90m│\r\r\n│\u001b[m   2. No (Esc to stop)                                                                                                \u001b[90m│\r\r\n│\u001b[118C│\r\r\n│\u001b[m \u001b[1m↑/↓\u001b[m to navigate · \u001b[1menter\u001b[m to select · \u001b[1mesc\u001b[m to cancel                                                                    \u001b[90m│\r\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[?7l╯\u001b[?7h\u001b[m"]
