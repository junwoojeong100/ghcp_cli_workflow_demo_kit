+class _Elements(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.by_id = {}
+        self.labels = set()
+
+    def handle_starttag(self, tag, attrs):
+        """Index the rendered controls without requiring a browser dependency."""
+        attributes = dict(attrs)
+        if "id" in attributes:
+            self.by_id[attributes["id"]] = (tag, attributes)
+        if tag == "label":
+            self.labels.add(attributes.get("for"))
+
+
+def test_refund_form_requires_bounded_reason(client):
+    """The rendered customer form exposes the required reason and its limit."""
+    elements = _Elements()
+    elements.feed(client.get("/").text)
+    tag, attributes = elements.by_id["reason"]
+    assert tag == "textarea"
+    assert "reason" in elements.labels
+    assert "required" in attributes
+    assert attributes["maxlength"] == "200"
+    assert attributes["placeholder"] == "Please enter a refund reason."
