+def test_reason_migration_preserves_data_and_legacy_inserts(tmp_path, monkeypatch):
+    migrations = migrate.MIGRATIONS
+    legacy_dir = tmp_path / "legacy_migrations"
+    legacy_dir.mkdir()
+    (legacy_dir / "001_init.sql").write_text(
+        (migrations / "001_init.sql").read_text(encoding="utf-8"), encoding="utf-8"
+    )
+    path = str(tmp_path / "legacy.db")
+    monkeypatch.setattr(migrate, "MIGRATIONS", legacy_dir)
+    migrate.apply_migrations(path)
+    seed(path, today=clock.today())
+    with closing(sqlite3.connect(path)) as conn:
+        customers = conn.execute("SELECT * FROM customers ORDER BY id").fetchall()
+        orders = conn.execute("SELECT * FROM orders ORDER BY id").fetchall()
+        refunds = conn.execute("SELECT * FROM refunds ORDER BY id").fetchall()
+    monkeypatch.setattr(migrate, "MIGRATIONS", migrations)
+    assert migrate.apply_migrations(path) == ["002_refund_reason"]
+    assert migrate.apply_migrations(path) == []
+    with closing(sqlite3.connect(path)) as conn:
+        assert conn.execute("SELECT * FROM customers ORDER BY id").fetchall() == customers
+        assert conn.execute("SELECT * FROM orders ORDER BY id").fetchall() == orders
+        assert (
+            conn.execute(
+                "SELECT id, order_id, amount, status, requested_at, decided_at"
+                " FROM refunds ORDER BY id"
+            ).fetchall()
+            == refunds
+        )
+        conn.execute(
+            "INSERT INTO refunds (order_id, amount, status, requested_at, decided_at)"
+            " VALUES (?, ?, ?, ?, ?)",
+            (refunds[0][1], 1, "REQUESTED", clock.now().isoformat(), None),
+        )
+        conn.commit()
+        assert conn.execute("SELECT reason FROM refunds").fetchall() == [(None,)] * (
+            len(refunds) + 1
+        )
