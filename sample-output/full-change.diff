+        ("reject", "REJECTED", "환불 요청이 반려되었습니다"),
+    ],
+)
+def test_고액_결정은_감사와_알림을_한번만_남긴다(
+    client, make_customer, make_order, query, admin_headers, action, status, subject
+):
+    order = make_order(make_customer(), amount=1_000_001)
+    created = refund(client, order, 1_000_001).json()
+    assert query("SELECT * FROM notifications") == []
+    res = client.post(f"/admin/refunds/{created['id']}/{action}", headers=admin_headers)
+    assert res.status_code == 200
+    assert res.json() == {**created, "status": status, "decided_at": clock.now().isoformat()}
+    events = query("SELECT actor, action, detail FROM audit_log ORDER BY id")
+    assert [(event["actor"], event["action"]) for event in events] == [
+        ("customer", "refund.requested"),
+        ("admin", f"refund.{status.lower()}"),
+    ]
+    assert json.loads(events[1]["detail"]) == {"refund_id": created["id"]}
+    assert query("SELECT reason FROM refunds") == [{"reason": "상품 불량"}]
+    notifications = query("SELECT subject, body FROM notifications")
+    assert len(notifications) == 1
+    assert subject in notifications[0]["subject"]
+    if action == "approve":
+        assert "1,000,001원" in notifications[0]["body"]
+    assert client.get("/admin/refunds?status=REQUESTED", headers=admin_headers).json() == []
+    for repeat in ("approve", "reject"):
+        denied = client.post(f"/admin/refunds/{created['id']}/{repeat}", headers=admin_headers)
+        assert denied.status_code == 400
+        assert denied.json()["detail"]["code"] == "NOT_PENDING"
+    assert query("SELECT actor, action, detail FROM audit_log ORDER BY id") == events
+    assert query("SELECT subject, body FROM notifications") == notifications
+
+
+@pytest.mark.parametrize("action", ["approve", "reject"])
+@pytest.mark.parametrize("headers", [{}, {"X-Admin-Token": "invalid-test-token"}])
+def test_고액_무인증_결정은_대기상태와_감사이력을_바꾸지_않는다(
+    client, make_customer, make_order, query, action, headers
+):
+    order = make_order(make_customer(), amount=1_000_001)
+    created = refund(client, order, 1_000_001).json()
+    events = query("SELECT * FROM audit_log")
+    res = client.post(f"/admin/refunds/{created['id']}/{action}", headers=headers)
+    assert res.status_code == 401
+    assert res.json()["detail"]["code"] == "UNAUTHORIZED"
+    assert client.get(f"/refunds/{created['id']}").json() == created
+    assert query("SELECT * FROM audit_log") == events
+    assert query("SELECT * FROM notifications") == []
+
+
+def test_반려된_고액의_예약금액은_재접수_한도에서_제외된다(
+    client, make_customer, make_order, admin_headers
+):
+    order = make_order(make_customer(), amount=1_000_001)
+    rid = refund(client, order, 1_000_001).json()["id"]
+    assert refund(client, order, 1).json()["detail"]["code"] == "AMOUNT_EXCEEDED"
+    rejected = client.post(f"/admin/refunds/{rid}/reject", headers=admin_headers)
+    assert rejected.status_code == 200
+    retried = refund(client, order, 1_000_001)
+    assert retried.status_code == 201
+    assert retried.json()["status"] == "REQUESTED"
+    assert retried.json()["id"] != rid
+
+
+def test_승인액과_고액_대기액을_합산해_주문한도를_지킨다(client, make_customer, make_order, query):
+    order = make_order(make_customer(), amount=2_000_001)
+    assert refund(client, order, 1_000_000).json()["status"] == "APPROVED"
+    assert refund(client, order, 1_000_001).json()["status"] == "REQUESTED"
+    denied = refund(client, order, 1)
+    assert denied.status_code == 400
+    assert denied.json()["detail"]["code"] == "AMOUNT_EXCEEDED"
+    assert len(query("SELECT id FROM refunds")) == 2
