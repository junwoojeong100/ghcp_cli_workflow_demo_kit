+def _run_refund_form(client, *, reason="  Wrong size  ", detail=None):
+    node = shutil.which("node")
+    if node is None:
+        pytest.skip("Node.js is needed to execute the actual customer page script.")
+    script = r"""
+const fs = require("fs");
+const vm = require("vm");
+const input = JSON.parse(fs.readFileSync(0, "utf8"));
+const elements = new Map();
+function element(id) {
+  if (!elements.has(id)) elements.set(id, {
+    value: "", innerHTML: "", children: [], listeners: {},
+    classList: { add() {}, toggle() {} },
+    addEventListener(event, handler) { this.listeners[event] = handler; },
+    replaceChildren(...children) { this.children = children; },
+    reportValidity() { return this.value.trim().length > 0 && this.value.length <= 200; }
+  });
+  return elements.get(id);
+}
+let submitted = null;
+const context = vm.createContext({
+  document: {
+    getElementById: element, querySelectorAll: () => [],
+    createElement: () => ({})
+  },
+  fetch: async (path, options = {}) => {
+    if (path === "/health") return {
+      ok: true, json: async () => ({env: "test", version: "test"})
+    };
+    if (path === "/customers") return {
+      ok: true, json: async () => [{id: 1, name: "Test", tier: "VIP"}]
+    };
+    if (path === "/customers/1/orders") return {ok: true, json: async () => []};
+    submitted = JSON.parse(options.body);
+    if (input.detail !== null) return {
+      ok: false, json: async () => ({detail: input.detail})
+    };
+    return {ok: true, json: async () => ({id: 1, status: "REQUESTED"})};
+  }
+});
+element("customer").value = "1";
+vm.runInContext(input.html.match(/<script>([\s\S]*?)<\/script>/)[1], context);
+(async () => {
+  await new Promise(setImmediate);
+  vm.runInContext("selectedOrder = 1", context);
+  element("amount").value = "1000001";
+  element("reason").value = input.reason;
+  await element("submit-refund").listeners.click();
+  const notice = element("result").children[0] || {};
+  console.log(JSON.stringify({
+    submitted, result: element("result").innerHTML,
+    errorText: notice.textContent || null,
+    errorHtml: notice.innerHTML || null
+  }));
+})().catch((error) => { console.error(error); process.exitCode = 1; });
+"""
+    result = subprocess.run(
+        [node, "-e", script],
+        input=json.dumps({"html": client.get("/").text, "reason": reason, "detail": detail}),
+        text=True,
+        capture_output=True,
+        check=True,
+    )
+    return json.loads(result.stdout)
+
+
+def test_refund_form_sends_trimmed_reason(client):
