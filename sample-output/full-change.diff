+def test_웹_환불입력과_오류안내를_실행한다(scenario):
+    node = shutil.which("node")
+    if node is None:
+        pytest.skip("웹 JavaScript 실행 검증에는 Node.js가 필요합니다.")
+    source = Path(__file__).resolve().parents[1] / "app" / "static" / "index.html"
+    script = r"""
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const vm = require("node:vm");
+const scenario = process.argv[2];
+const elements = new Map();
+function element(id) {
+  if (!elements.has(id)) elements.set(id, {
+    value: id === "customer" ? "1" : "", innerHTML: "", textContent: "",
+    listeners: {}, classList: { add() {}, remove() {} },
+    addEventListener(event, handler) { this.listeners[event] = handler; },
+    replaceChildren(...children) { this.children = children; },
+    focus() { this.focused = true; }
+  });
+  return elements.get(id);
+}
+const requests = [];
+const unsafe = "<img src=x onerror=alert(1)>입력 안내";
+const context = vm.createContext({
+  document: { getElementById: element, querySelectorAll: () => [],
+              createElement: () => ({}) },
+  fetch: async (path, options = {}) => {
+    let body;
+    if (options.method === "POST") {
+      requests.push({ path, body: JSON.parse(options.body) });
+      if (scenario === "422안내") return {
+        ok: false, json: async () => ({
+          detail: [{ loc: ["body", "reason"], msg: "invalid reason" }]
+        })
+      };
+      if (scenario === "400안전출력") return {
+        ok: false, json: async () => ({
+          detail: { code: "REASON_REQUIRED", message: unsafe }
+        })
+      };
+      body = { id: 1, status: "REQUESTED" };
+    } else if (path === "/health") body = { env: "test", version: "test" };
+    else if (path === "/customers") body = [{ id: 1, name: "test", tier: "VIP" }];
+    else body = [];
+    return { ok: true, json: async () => body };
+  }
+});
+const html = fs.readFileSync(process.argv[1], "utf8");
+vm.runInContext(html.match(/<script>([\s\S]*?)<\/script>/)[1], context);
+(async () => {
