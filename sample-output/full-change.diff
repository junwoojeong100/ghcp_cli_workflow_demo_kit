+import io
+import json
+import os
+import sqlite3
+import subprocess
+import sys
+import tarfile
+from pathlib import Path
+
+import pytest
+
+from scripts.migrate import apply_migrations
+
+PREVIOUS_RELEASE = "5d2b2035f2527ee950d91dbaf6fd342fc49aebef"
+
+
+@pytest.fixture()
+def legacy_database(tmp_path):
+    """Build historical data using a fixed previous release, never a moving branch."""
+    archive = subprocess.run(
+        [
+            "git",
+            "archive",
+            PREVIOUS_RELEASE,
+            "app",
+            "db",
+            "scripts/migrate.py",
+            "scripts/__init__.py",
+        ],
+        cwd=Path(__file__).resolve().parents[1],
+        check=True,
+        capture_output=True,
+    )
+    release = tmp_path / "previous-release"
+    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as source:
+        source.extractall(release, filter="data")
+    database = tmp_path / "historical.db"
+    subprocess.run(
+        [sys.executable, str(release / "scripts/migrate.py"), str(database)],
+        cwd=release,
+        check=True,
+        capture_output=True,
+    )
+    with sqlite3.connect(database) as connection:
+        connection.execute(
+            "INSERT INTO customers VALUES (?, ?, ?, ?, ?)",
+            (1, "Historical customer", "history@example.com", "vip ", "2026-10-15"),
+        )
+        connection.execute(
+            "INSERT INTO orders VALUES (?, ?, ?, ?, ?)",
+            (1, 1, 100_000, "DELIVERED", "2026-10-15"),
+        )
+        connection.executemany(
+            "INSERT INTO refunds VALUES (?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, 1_000, "APPROVED", "2026-10-15", "2026-10-15"),
+                (2, 1, 2_000, "REQUESTED", "2026-10-15", None),
+                (3, 1, 3_000, "REJECTED", "2026-10-15", "2026-10-15"),
+            ],
+        )
+        connection.execute(
+            "INSERT INTO audit_log (at, actor, action, detail) VALUES (?, ?, ?, ?)",
+            ("2026-10-15", "admin", "refund.approved", '{"refund_id": 1}'),
+        )
+        connection.execute(
+            "INSERT INTO notifications "
+            "(at, customer_id, channel, subject, body) VALUES (?, ?, ?, ?, ?)",
+            ("2026-10-15", 1, "EMAIL", "Historical subject", "Historical body"),
+        )
+    return release, database
+
+
+def _business_snapshot(database):
+    statements = [
+        "SELECT * FROM customers ORDER BY id",
+        "SELECT * FROM orders ORDER BY id",
+        "SELECT id, order_id, amount, status, requested_at, decided_at FROM refunds ORDER BY id",
+        "SELECT * FROM audit_log ORDER BY id",
+        "SELECT * FROM notifications ORDER BY id",
+    ]
+    with sqlite3.connect(database) as connection:
+        return [connection.execute(statement).fetchall() for statement in statements]
+
+
+def test_refund_reason_migration_preserves_historical_data(legacy_database):
+    """Keep every historical business row and represent unknown reasons as NULL."""
+    _, database = legacy_database
+    before = _business_snapshot(database)
+    assert apply_migrations(str(database)) == ["002_add_refund_reason"]
+    assert _business_snapshot(database) == before
+    with sqlite3.connect(database) as connection:
+        assert connection.execute("SELECT reason FROM refunds").fetchall() == [
+            (None,),
+            (None,),
+            (None,),
+        ]
+    assert apply_migrations(str(database)) == []
+    assert _business_snapshot(database) == before
+
+
+def test_previous_release_can_read_and_write_expanded_schema(legacy_database, tmp_path):
+    """Run the complete pinned old app against the migrated DB in an isolated process."""
+    release, database = legacy_database
+    apply_migrations(str(database))
+    script = """
+import json
+from datetime import datetime, timezone
+from fastapi.testclient import TestClient
+from app import clock
+from app.main import app
+
+clock.now = lambda: datetime(2026, 10, 16, 3, tzinfo=timezone.utc)
+clock.today = lambda: clock.now().date()
+with TestClient(app) as client:
+    historical = client.get("/refunds/1")
+    created = client.post("/orders/1/refund", json={"amount": 1000})
+    print(json.dumps({
+        "historical_status": historical.status_code,
+        "historical_amount": historical.json()["amount"],
+        "created_status": created.status_code,
+        "created": created.json(),
+    }))
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script],
+        cwd=release,
+        env={
+            **os.environ,
+            "DB_PATH": str(database),
+            "LOG_PATH": str(tmp_path / "legacy-access.log"),
+            "PYTHONPATH": str(release),
+            "PYTHONDONTWRITEBYTECODE": "1",
+        },
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    outcome = json.loads(result.stdout)
+    assert outcome["historical_status"] == 200
+    assert outcome["historical_amount"] == 1_000
+    assert outcome["created_status"] == 201
+    assert outcome["created"]["status"] == "APPROVED"
+    with sqlite3.connect(database) as connection:
+        assert connection.execute(
+            "SELECT reason FROM refunds WHERE id = ?", (outcome["created"]["id"],)
+        ).fetchone() == (None,)
